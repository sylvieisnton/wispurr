{
	"name": "wispurr",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sylvieisnton/wispurr.git"
	},
	"version": "4.2.3",
	"module": "index.ts",
	"type": "module",
	"author": "Sylvia Calabrese",
	"license": "AGPL-3.0-only",
	"private": false,
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"default": "./dist/vite.js"
		},
		"./package.json": "./package.json",
		"./dist/*": "./dist/*"
	},
	"devDependencies": {
		"@types/node": "^25.5.0"
	},
	"peerDependencies": {
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"chalk": "^5.6.2",
		"detect-port": "^2.1.0"
	},
	"scripts": {
		"test": "npm run compile && node --test --test-timeout=10000 tests/*.test.mjs",
		"compile": "tsc",
		"build": "npm run compile && node scripts/build.mjs"
	}
}
