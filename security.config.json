{
	"port": 6001,
	"allowTCP": true,
	"allowUDP": false,
	"allowDirectIP": false,
	"allowPrivateIPs": false,
	"allowLoopbackIPs": false,
	"tcpBufferSize": 262144,
	"socketBufferSize": 8388608,
	"pendingQueueSize": 16777216,
	"bufferRemainingLength": 4096,
	"tcpNoDelay": true,
	"blacklist": { "hostnames": {}, "ports": {} },
	"whitelist": { "hostnames": {}, "ports": {} },
	"websocketPermessageDeflate": false,
	"dnsServers": [],
	"dnsMethod": "resolve",
	"dnsResultOrder": "ipv4first",
	"enableTwisp": false,
	"enableV2": true,
	"handshakeTimeoutSeconds": 5,
	"motd": "",
	"passwordAuth": false,
	"passwordAuthRequired": false,
	"passwordUsers": {},
	"parseRealIP": true,
	"trustedProxies": ["127.0.0.1"],
	"trustedHeaders": ["CF-Connecting-IP", "X-Forwarded-For"],
	"nonWSResponse": "",
	"logLevel": "info",
	"proxy": "",
	"maxMessageSize": 262144,
	"staticDir": "",
	"bandwidthLimitKbps": 1000000,
	"connectionsLimitPerIP": 20,
	"connectionWindowSeconds": 10,
	"floodProtection": {
		"enabled": true,
		"maxConnectsPerSourceIPPerSecond": 25,
		"maxConnectsPerDestPerSecond": 4,
		"maxConnectsPerDestPerMinute": 30,
		"maxInFlightSyns": 128,
		"maxConcurrentStreamsPerConnection": 128,
		"maxConcurrentConnections": 2048,
		"synFloodSignature": {
			"enabled": true,
			"windowMs": 2000,
			"minSamples": 16,
			"failedHandshakeRatio": 0.6
		},
		"wsCloseAfterViolations": 8,
		"logBlockedDials": true
	},
	"reputation": {
		"enabled": true,
		"storePath": "./data/wispurr-reputation.json",
		"saveIntervalSeconds": 15,
		"scoreDecayPerHour": 1,
		"evictAfterDays": 14,
		"thresholds": { "warn": 10, "throttle": 25, "strict": 50 },
		"weights": {
			"privateEgress": 25,
			"synSignature": 40,
			"twispNoAuth": 50,
			"burstRate": 10,
			"successfulStream": -1,
			"requestKnownBadDest": 5
		},
		"destinationWeights": {
			"privateEgress": 30,
			"synSignature": 45,
			"distinctSourcesEscalation": 2
		}
	}
}
